{
  "name": "@requestly/cross-q-context",
  "version": "0.1.0",
  "description": "cross-q-context — the API-client scripting core. This build ships the transform pillar: rewrite every script dialect (Postman pm.*/postman.*, Bruno bru.*) to the rq.* API (OXC-based Rust → WebAssembly, strings in / typed objects out). The execute pillar (the safe QuickJS engine) is the app's quickjs-emscripten runtime, absorbed here as JS — not a separate Rust runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitu/rq.git",
    "directory": "packages/cross-q-context"
  },
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./codegen": {
      "types": "./src/runtime/definitions/codegen/generate-types.ts",
      "default": "./src/runtime/definitions/codegen/generate-types.ts"
    },
    "./executor": {
      "types": "./dist/runtime/engine/index.d.ts",
      "default": "./dist/runtime/engine/index.js"
    },
    "./ssrf-guard": {
      "types": "./dist/runtime/engine/ssrf-guard.d.ts",
      "default": "./dist/runtime/engine/ssrf-guard.js"
    },
    "./executor/browser": {
      "types": "./dist/runtime/engine/browser/index.d.ts",
      "default": "./dist/runtime/engine/browser/index.js"
    }
  },
  "imports": {
    "#engine": {
      "requestly-cli-node": "./engine-node/cross_q_context.js",
      "node": "./engine-node/cross_q_context.js",
      "default": "./engine/cross_q_context.js"
    }
  },
  "files": [
    "src",
    "dist",
    "engine",
    "engine-node"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/cq-transform --target bundler --out-dir ../../packages/cross-q-context/engine --out-name cross_q_context && wasm-pack build ../../crates/cq-transform --target nodejs --out-dir ../../packages/cross-q-context/engine-node --out-name cross_q_context",
    "build:runtime": "tsc && npm run build:guest-bundle",
    "test": "node test/entry-hygiene.mjs && node test/smoke.mjs && node test/executor-smoke.mjs && node test/execute-e2e.mjs && node test/engine-streaming.mjs && node test/developer-engine.mjs",
    "build:guest-bundle": "node src/runtime/engine/guest-bundle-codegen.mjs",
    "generate:vendor": "tsx src/runtime/engine/vendor-codegen/generate-vendor-iifes.ts"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-asyncify": "^0.32.0",
    "@jitl/quickjs-singlefile-cjs-release-asyncify": "0.32.0",
    "@noble/hashes": "^1.8.0",
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/wasm-node": "4.40.2",
    "chai": "6.2.2",
    "fflate": "^0.8.3",
    "node-inspect-extracted": "^3.3.3",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@types/chai": "5.2.2",
    "@types/crypto-js": "4.2.2",
    "@types/node": "^22.20.1",
    "@types/uuid": "10.0.0",
    "@types/xml2js": "0.4.14",
    "ajv": "8.17.1",
    "cheerio": "1.0.0",
    "crypto-js": "4.2.0",
    "csv-parse": "5.6.0",
    "esbuild": "0.25.12",
    "events": "3.3.0",
    "handlebars": "4.7.9",
    "lodash": "4.17.21",
    "moment": "2.30.1",
    "nanoid": "6.0.1",
    "prettier": "3.9.6",
    "tsx": "^4.19.2",
    "tv4": "1.3.0",
    "typescript": "5.7.3",
    "uuid": "11.1.0",
    "xml2js": "0.6.2"
  }
}
